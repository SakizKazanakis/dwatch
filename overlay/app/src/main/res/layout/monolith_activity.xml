<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/monolith_ink"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/monolith_logo" />

        <TextView
            android:id="@+id/monolith_wordmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/michroma"
            android:letterSpacing="0.14"
            android:text="MONOLITH"
            android:textColor="@color/monolith_bone"
            android:textSize="16sp" />

        <TextView
            style="@style/MonolithEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/monolith_version"
            android:text="v0.2"
            android:textColor="@color/monolith_signal_dim" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/monolith_seam" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Device -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/MonolithEyebrow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Устройство" />

                    <View
                        android:id="@+id/monolith_link_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginEnd="8dp"
                        android:background="@color/monolith_signal" />

                    <TextView
                        android:id="@+id/monolith_link_state"
                        style="@style/MonolithEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/monolith_signal" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/MonolithEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/monolith_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="5dp"
                        android:text="Телефон"
                        android:textSize="10sp" />

                    <nodomain.freeyourgadget.gadgetbridge.monolith.PulseWireView
                        android:id="@+id/monolith_wire"
                        android:layout_width="0dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/MonolithEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/monolith_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="5dp"
                        android:text="Часы"
                        android:textColor="@color/monolith_bone"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/monolith_phone_battery"
                            style="@style/MonolithNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp" />

                        <TextView
                            style="@style/MonolithEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Телефон"
                            android:textSize="10sp" />

                        <ProgressBar
                            android:id="@+id/monolith_phone_battery_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="6dp"
                            android:max="100"
                            android:progressDrawable="@drawable/monolith_bar" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/monolith_watch_battery"
                            style="@style/MonolithNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="20sp" />

                        <TextView
                            style="@style/MonolithEyebrow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Часы"
                            android:textSize="10sp" />

                        <ProgressBar
                            android:id="@+id/monolith_watch_battery_bar"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="3dp"
                            android:layout_marginTop="6dp"
                            android:layoutDirection="rtl"
                            android:max="100"
                            android:progressDrawable="@drawable/monolith_bar" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/monolith_device_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plex_sans"
                        android:textColor="@color/monolith_bone"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/monolith_device_address"
                        style="@style/MonolithEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.06"
                        android:textAllCaps="false"
                        android:textColor="@color/monolith_signal_dim" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/monolith_seam" />

            <!-- Pulse, steps, air temperature -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/MonolithEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Пульс" />

                    <TextView
                        android:id="@+id/monolith_heart_rate"
                        style="@style/MonolithNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="—"
                        android:textSize="26sp" />

                    <TextView
                        style="@style/MonolithEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="уд/мин"
                        android:textColor="@color/monolith_signal_dim" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/monolith_seam" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/MonolithEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Шаги" />

                    <TextView
                        android:id="@+id/monolith_steps"
                        style="@style/MonolithNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="—"
                        android:textSize="26sp" />

                    <TextView
                        style="@style/MonolithEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="сегодня"
                        android:textColor="@color/monolith_signal_dim" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="@color/monolith_seam" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/MonolithEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Воздух" />

                    <TextView
                        android:id="@+id/monolith_temperature"
                        style="@style/MonolithNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="—"
                        android:textSize="26sp" />

                    <TextView
                        style="@style/MonolithEyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/monolith_weather_note"
                        android:layout_marginTop="4dp"
                        android:text="°C · погода"
                        android:textColor="@color/monolith_signal_dim" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/monolith_seam" />

            <!-- Coordinates -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/MonolithEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Координаты · GPS телефона" />

                <TextView
                    android:id="@+id/monolith_coords"
                    style="@style/MonolithNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/monolith_chip"
                    android:lineSpacingExtra="6dp"
                    android:padding="14dp"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/monolith_seam" />

            <!-- Quick actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    style="@style/MonolithEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Быстрые действия" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/monolith_find"
                        style="@style/MonolithAction"
                        android:text="Найти часы" />

                    <Button
                        android:id="@+id/monolith_sync"
                        style="@style/MonolithAction"
                        android:layout_marginStart="10dp"
                        android:text="Синхр." />

                    <Button
                        android:id="@+id/monolith_settings"
                        style="@style/MonolithAction"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/monolith_cell_solid"
                        android:text="Настройки"
                        android:textColor="@color/monolith_ink" />
                </LinearLayout>

                <Button
                    android:id="@+id/monolith_dial_bg"
                    style="@style/MonolithAction"
                    android:layout_width="match_parent"
                    android:layout_weight="0"
                    android:layout_marginTop="10dp"
                    android:text="Фон Monolith на часы" />

                <TextView
                    android:id="@+id/monolith_dial_status"
                    style="@style/MonolithEyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAllCaps="false"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
